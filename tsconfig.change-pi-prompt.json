{
  // 内置扩展的独立类型检查配置（目前覆盖 change-pi-prompt / security-gate / vision）。
  //
  // 为什么单独一份：扩展源码在 `resources/` 下，不在主 `tsconfig.json` 的
  // include 范围内；而且它的运行环境是 pi（jiti 直跑 .ts），不是 Electron 的
  // 构建管线，编译选项不能跟主工程共用（例如 `.ts` 后缀的相对 import 在
  // NodeNext 下会直接报错，但 pi 侧要求保留后缀）。
  //
  // 该配置由 `npm run typecheck` 链式调用。类型来自 prepare:pi-latest 临时安装到
  // .cache/pi-latest 的 npm latest SDK，与根构建依赖隔离，不钉死版本。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Only extension compatibility checks use latest Pi; application builds keep
    // their root lockfile graph. Pi's own imports resolve inside its fixture.
    // paths 相对本 tsconfig 所在目录解析（TS>=4.1），不需要 baseUrl，避免裸模块名被误按仓库根解析。
    "paths": {
      "@earendil-works/*": ["./.cache/pi-latest/node_modules/@earendil-works/*"],
      // 内置扩展（如 pi-deck-todo）直接用 pi 运行时的 typebox，与 PiDeck 构建依赖隔离。
      "typebox": ["./.cache/pi-latest/node_modules/typebox"]
    },
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // 扩展以 `.ts` 后缀互相 import（pi 用 jiti 直跑源码，Node 22 亦同）。
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "resources/extensions/pideck-q-change-pi-prompt.ts",
    "resources/extensions/pideck-q-change-pi-prompt/**/*.ts",
    "resources/extensions/pi-deck-todo.ts",
    "resources/extensions/pi-deck-security-gate.ts",
    "resources/extensions/pi-deck-vision.ts"
  ],
  "exclude": ["resources/extensions/pideck-q-change-pi-prompt/tests"]
}
