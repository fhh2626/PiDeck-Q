    "ai": "^7.0.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.6.0",
    "html-to-image": "^1.11.13",
    "jotai": "^2.20.2",
    "katex": "^0.17.0",
