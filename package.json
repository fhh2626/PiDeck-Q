{
  "name": "pi-desktop",
  "version": "0.1.5",
  "description": "PiDeck-Q is an open-source desktop workbench supporting the original Pi Agent and Pi_Agent_Rust across local project folders with session history, Git integration, terminal, and config management.",
  "private": true,
  "engines": {
    "node": "24.19.0",
    "npm": ">=11"
  },
  "license": "MIT",
  "author": {
    "name": "ayuayue",
    "email": "ayuayue@users.noreply.github.com"
  },
  "contributors": [
    {
      "name": "1900EasonJin",
      "url": "https://github.com/1900EasonJin"
    }
  ],
  "homepage": "https://github.com/fhh2626/PiDeck-Q#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fhh2626/PiDeck-Q.git"
  },
  "bugs": {
    "url": "https://github.com/fhh2626/PiDeck-Q/issues"
  },
  "keywords": [
    "pi",
    "pi-agent",
    "ai-coding-agent",
    "coding-agent",
    "desktop",
    "desktop-app",
    "rpc",
    "agent",
    "ai-assistant",
    "local-ai",
    "developer-tools",
    "productivity",
    "workspace",
    "session-management",
    "git",
    "terminal",
    "monaco-editor",
    "claude-code",
    "codex",
    "multi-project",
    "typescript",
    "windows",
    "macos",
    "linux",
    "open-source"
  ],
  "scripts": {
    "dev": "node scripts/dev-native.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:node",
    "build:fast": "npm run build:renderer && npm run build:node",
    "build:renderer": "vite build",
    "build:node": "node scripts/build-native-node.mjs",
    "build:native": "node scripts/build-native.mjs",
    "pack": "npm run build && npm run build:native && node scripts/verify-build-artifacts.mjs --out release/win-unpacked",
    "dist:win": "node scripts/dist-win-native.mjs",
    "dist:win:dev": "node scripts/dev-native.mjs",
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:serial": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "typecheck": "tsc --noEmit",
    "make-icon": "node scripts/make-icon.js",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:native",
    "sync:model-specs": "node scripts/sync-model-specs.mjs",
    "verify:build-artifacts": "node scripts/verify-build-artifacts.mjs --out release/win-unpacked"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "motion": "^13.0.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react-day-picker": "^10.0.1",
    "shiki": "^4.4.3",
    "sql.js": "^1.14.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.51",
    "@astron-team/skillhub": "^0.1.8",
    "@codemirror/autocomplete": "^6.20.3",
